@page
@model GunnyPanel.Pages.JobsModel
@{
    ViewData["Title"] = "Jobs & Tools";
    ViewData["Subtitle"] = "Đồng bộ XML từ VNG, cập nhật nguồn Tool XML và import dữ liệu vào DB";
    var running = Model.Jobs.Any(j => j.Status == JobStatus.Running || j.Status == JobStatus.Pending);
}

@if (!Model.CanRun)
{
    <div class="alert danger">Tài khoản của bạn chỉ có quyền xem Jobs &amp; Tools — không thể chạy hoặc huỷ job. Cần role Develop/Admin.</div>
}

<div class="grid">
    <section class="card">
        <h2>1) Sync XML VNG → local</h2>
        <p class="muted small">Tải bộ XML mới nhất từ quest server, nén zlib (nếu server trả plain), ghi vào thư mục IIS port 88 để Tool XML của Admincp đọc được.</p>
        <form method="post" asp-page-handler="Sync">
            <label>Source URL</label>
            <input name="SyncSource" value="@Model.SyncSource" />
            <label>Thư mục đích (mirror)</label>
            <input name="SyncDest" value="@Model.SyncDest" />
            <label>Ghi đè file đã có</label>
            <select name="SyncOverwrite">
                <option value="true" selected="@Model.SyncOverwrite">Có</option>
                <option value="false" selected="@(!Model.SyncOverwrite)">Không</option>
            </select>
            <button type="submit" class="btn primary" disabled="@(Model.CanRun ? null : "disabled")"><i class="fa fa-download"></i> Chạy job Sync XML</button>
        </form>
    </section>

    <section class="card">
        <h2>2) Cập nhật Db_Gm.dbo.Url_Tank</h2>
        <p class="muted small">Đổi nguồn cho Tool XML. URL phải bắt đầu bằng <b>http://</b> và kết thúc bằng <b>/</b>.</p>
        <form method="post" asp-page-handler="UpdateUrl">
            <label>Name (URL)</label>
            <input name="UrlName" value="@Model.UrlName" />
            <label>Detail</label>
            <input name="UrlDetail" value="@Model.UrlDetail" />
            <button type="submit" class="btn primary" disabled="@(Model.CanRun ? null : "disabled")"><i class="fa fa-cogs"></i> Chạy job cập nhật Url_Tank</button>
        </form>
        <hr />
        <form method="post" asp-page-handler="Check">
            <button type="submit" class="btn" disabled="@(Model.CanRun ? null : "disabled")"><i class="fa fa-refresh"></i> Kiểm tra kết nối SQL + VNG</button>
        </form>
    </section>

    <section class="card">
        <h2>3) Request XML → SQL</h2>
        <p class="muted small">Sinh câu lệnh INSERT từ XML của VNG vào bảng tương ứng (map qua <code>Db_Gm.dbo.Table_Games.XmlName</code>). Mặc định là <b>dry-run</b> — chỉ sinh file .sql, chưa ghi DB.</p>
        <form method="post" asp-page-handler="RequestSql">
            <label>Tên XML (gõ hoặc chọn)</label>
            <input name="ReqXml" value="@Model.ReqXml" list="xml-names" placeholder="levellist, balllist, serverconfig..." />
            <datalist id="xml-names">
                @foreach (var item in Model.XmlNames)
                {
                    <option value="@item.Xml" label="@item.Table"></option>
                }
            </datalist>

            <label>Preset ToolRip</label>
            <select id="toolrip-preset">
                <option value="">-- chọn nhanh XML quen thuộc --</option>
                @foreach (var name in Model.ToolRipXmls)
                {
                    <option value="@name">@name</option>
                }
            </select>

            <div class="field-grid">
                <div>
                    <label>Nguồn XML</label>
                    <select name="ReqSource" id="req-source">
                        <option value="local" selected="@(Model.ReqSource == "local")">Local mirror (đã sync)</option>
                        <option value="vng" selected="@(Model.ReqSource == "vng")">Tải trực tiếp từ VNG</option>
                        <option value="file" selected="@(Model.ReqSource == "file")">File XML local (đường dẫn)</option>
                    </select>
                </div>
                <div>
                    <label>DB đích</label>
                    <select name="ReqConnection">
                        @foreach (var c in Model.Connections)
                        {
                            <option value="@c" selected="@(c == Model.ReqConnection)">@c</option>
                        }
                    </select>
                </div>
            </div>

            <label>Đường dẫn XML local (khi Nguồn = File local)</label>
            <input name="ReqPath" value="@Model.ReqPath" placeholder="vd: C:\Gunny\Gunny12.6\WebSite\Request\vng-quest\item.xml" />

            <label>Tên bảng ghi đè (để trống = tự map)</label>
            <input name="ReqTable" value="@Model.ReqTable" placeholder="vd: LevelInfo" />

            <div class="field-grid">
                <div>
                    <label>AutoID (như ToolRip)</label>
                    <select name="ReqAutoId">
                        <option value="false" selected="@(!Model.ReqAutoId)">Không thêm ID</option>
                        <option value="true" selected="@Model.ReqAutoId">Thêm cột ID tăng dần</option>
                    </select>
                </div>
                <div>
                    <label>Kiểu SQL</label>
                    <select name="ReqStyle">
                        <option value="compact" selected="@(Model.ReqStyle == "compact")">Compact (multi-row batch)</option>
                        <option value="toolrip" selected="@(Model.ReqStyle == "toolrip")">ToolRip (1 INSERT / dòng)</option>
                    </select>
                </div>
            </div>

            <label>Chế độ</label>
            <select name="ReqExecute">
                <option value="false" selected="@(!Model.ReqExecute)">Chạy thử (dry-run — chỉ sinh file SQL)</option>
                <option value="true" selected="@Model.ReqExecute">Ghi vào DB (transaction, rollback nếu lỗi)</option>
            </select>
            <p class="muted small" style="margin:6px 0 0;">⚠️ Chạy nhiều lần sẽ bị trùng dữ liệu — nên backup DB trước khi import thật.</p>
            <button type="submit" class="btn primary" disabled="@(Model.CanRun ? null : "disabled")"><i class="fa fa-bolt"></i> Chạy job Request XML → SQL</button>
        </form>
    </section>

    <section class="card">
        <h2>4) Sync resource VNG (flash)</h2>
        <p class="muted small">Tải lại file trong <code>WebSite\Flash</code> từ resource server VNG. Mặc định <b>dry-run</b> chỉ quét &amp; thống kê, chưa tải file nào.</p>
        <p class="muted small">💡 Cần <b>rip toàn bộ flash VNG về folder</b> (loại trừ 2.png/4.png, tiến độ realtime, report + manifest)?
            Dùng trang <a href="/FlashRip"><b>Rip Flash</b></a>.</p>
        <form method="post" asp-page-handler="ResourceSync">
            <label>Source URL</label>
            <input name="ResSource" value="@Model.ResSource" />
            <label>Thư mục đích</label>
            <input name="ResTarget" value="@Model.ResTarget" />
            <div class="field-grid">
                <div>
                    <label>Số file tối đa (0 = tất cả)</label>
                    <input type="number" name="ResMaxFiles" value="@Model.ResMaxFiles" min="0" />
                </div>
                <div>
                    <label>Ghi đè file đã có</label>
                    <select name="ResOverwrite">
                        <option value="true" selected="@Model.ResOverwrite">Có</option>
                        <option value="false" selected="@(!Model.ResOverwrite)">Không</option>
                    </select>
                </div>
            </div>
            <label>Chế độ</label>
            <select name="ResDryRun">
                <option value="true" selected="@Model.ResDryRun">Dry-run — chỉ quét &amp; thống kê, không tải</option>
                <option value="false" selected="@(!Model.ResDryRun)">Tải thật (ghi đè WebSite\Flash)</option>
            </select>
            <p class="muted small" style="margin:8px 0 0;">⚠️ Bỏ dry-run sẽ tải file thật đè lên <code>WebSite\Flash</code>. Bộ flash có thể rất lớn (~hàng trăm MB) — nên thử <code>maxFiles=20</code> trước.</p>
            <button type="submit" class="btn primary" disabled="@(Model.CanRun ? null : "disabled")"><i class="fa fa-download"></i> Chạy job Sync resource</button>
        </form>
    </section>

    <section class="card">
        <h2>5) Chuyển đổi Bomb (.bomb ⇄ PNG)</h2>
        <p class="muted small">Đọc mask 1bpp của Gunny và xuất PNG (hoặc ngược lại) để kiểm tra/sửa. Chỉ ghi ra <code>GunnyPanel\data\out</code> — không sửa folder <code>Service</code>.</p>
        <form method="post" asp-page-handler="BombConvert">
            <label>Chế độ</label>
            <select name="BombMode">
                <option value="to-png" selected="@(Model.BombMode == "to-png")">.bomb → PNG</option>
                <option value="to-bomb" selected="@(Model.BombMode == "to-bomb")">PNG → .bomb</option>
            </select>
            <label>Thư mục nguồn</label>
            <input name="BombSource" value="@Model.BombSource" />
            <label>Thư mục xuất (để trống = tự động trong data\out)</label>
            <input name="BombOutput" value="@Model.BombOutput" placeholder="mặc định: data\out\bomb-png hoặc data\out\bomb" />
            <div class="field-grid">
                <div>
                    <label>Số file tối đa (0 = tất cả)</label>
                    <input type="number" name="BombMaxFiles" value="@Model.BombMaxFiles" min="0" />
                </div>
                <div>
                    <label>Ngưỡng sáng (PNG → bomb)</label>
                    <input type="number" name="BombThreshold" value="@Model.BombThreshold" min="1" max="254" />
                </div>
            </div>
            <label>Ghi đè file đã có</label>
            <select name="BombOverwrite">
                <option value="true" selected="@Model.BombOverwrite">Có</option>
                <option value="false" selected="@(!Model.BombOverwrite)">Không</option>
            </select>
            <button type="submit" class="btn primary" disabled="@(Model.CanRun ? null : "disabled")"><i class="fa fa-refresh"></i> Chạy job Bomb</button>
        </form>
    </section>
</div>

<section class="card">
    <div class="page-head">
        <h2>Jobs <span class="muted small">(@Model.JobTotal)</span></h2>
        <span class="muted small">Trang @Model.JobPage / @(Math.Max(1, (int)Math.Ceiling(Model.JobTotal / (double)GunnyPanel.Pages.JobsModel.JobPageSize)))</span>
    </div>
    @if (Model.Jobs.Count == 0)
    {
        <p class="muted">Chưa có job.</p>
    }
    else
    {
        <div class="table-wrap">
            <table class="list">
                <thead>
                <tr>
                    <th>Thời gian</th><th>Job</th><th>Người tạo</th><th>Trạng thái</th><th>Tiến độ</th><th></th>
                </tr>
                </thead>
                <tbody>
                @foreach (var job in Model.Jobs)
                {
                    <tr>
                        <td class="mono">@job.CreatedAt.ToString("dd/MM HH:mm:ss")</td>
                        <td>
                            <b>@job.Title</b>
                            @if (!string.IsNullOrEmpty(job.Error) || !string.IsNullOrEmpty(job.Result))
                            {
                                <details>
                                    <summary class="muted small">kết quả / log</summary>
                                    <pre class="log">@(job.Error ?? job.Result)
@string.Join("\n", job.Log.TakeLast(30))</pre>
                                </details>
                            }
                        </td>
                        <td>@job.CreatedBy</td>
                        <td class="@(job.Status == JobStatus.Success ? "ok" : job.Status == JobStatus.Failed ? "bad" : "")">@job.Status</td>
                        <td>
                            <div class="progress"><div style="width:@(job.Progress)%"></div></div>
                            <span class="muted small">@job.Progress%</span>
                        </td>
                        <td>
                            @if (job.Status == JobStatus.Running || job.Status == JobStatus.Pending)
                            {
                                <form method="post" asp-page-handler="Cancel" asp-route-id="@job.Id">
                                    <button type="submit" class="btn small danger" disabled="@(Model.CanRun ? null : "disabled")"><i class="fa fa-times"></i> Hủy</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        var jobPager = new GunnyPanel.Pages.Shared.Pager
        {
            Page = Model.JobPage,
            PageSize = GunnyPanel.Pages.JobsModel.JobPageSize,
            Total = Model.JobTotal,
            Path = "/Jobs",
            PageParam = "jpage"
        };
        <partial name="_Pager" model="jobPager" />
    }
</section>

<section class="card">
    <div class="page-head">
        <h2>File SQL đã sinh (dry-run) <span class="muted small">(@Model.SqlTotal)</span></h2>
    </div>
    @if (Model.SqlFiles.Count == 0)
    {
        <p class="muted">Chưa có file SQL nào. Chạy job <b>Request XML → SQL</b> ở trên (chọn “Chạy thử”) để sinh file.</p>
    }
    else
    {
        <div class="table-wrap">
            <table class="list compact">
                <thead><tr><th>Thời gian</th><th>File</th><th>Kích thước</th><th></th></tr></thead>
                <tbody>
                @foreach (var file in Model.SqlFiles)
                {
                    <tr>
                        <td class="mono">@file.Time.ToString("dd/MM HH:mm:ss")</td>
                        <td class="mono">@file.Name</td>
                        <td class="muted small">@((file.Size / 1024.0).ToString("0.0")) KB</td>
                        <td><a class="btn small" href="?handler=Download&name=@Uri.EscapeDataString(file.Name)"><i class="fa fa-download"></i> Tải</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        var sqlPager = new GunnyPanel.Pages.Shared.Pager
        {
            Page = Model.SqlPage,
            PageSize = GunnyPanel.Pages.JobsModel.SqlPageSize,
            Total = Model.SqlTotal,
            Path = "/Jobs",
            PageParam = "spage"
        };
        <partial name="_Pager" model="sqlPager" />
    }
</section>

@section Scripts {
    <script>
        (function () {
            var preset = document.getElementById('toolrip-preset');
            if (!preset) return;
            preset.addEventListener('change', function () {
                if (!this.value) return;
                var box = document.querySelector('input[name="ReqXml"]');
                if (box) box.value = this.value;
                var src = document.getElementById('req-source');
                if (src) src.value = 'local';
            });
        })();
    </script>
    @if (running)
    {
        <script>setTimeout(function () { location.reload(); }, 4000);</script>
    }
}
