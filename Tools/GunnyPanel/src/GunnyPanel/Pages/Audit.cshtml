@page
@model GunnyPanel.Pages.AuditModel
@{
    ViewData["Title"] = "Audit log";
    ViewData["Subtitle"] = "Lịch sử thao tác: login, job, import, cancel…";
    var from = Model.Total == 0 ? 0 : (Model.PageIndex - 1) * GunnyPanel.Pages.AuditModel.PageSize + 1;
    var to = Math.Min(Model.Total, Model.PageIndex * GunnyPanel.Pages.AuditModel.PageSize);
}
<section class="card">
    <div class="page-head">
        <h2>Audit log <span class="muted small">(@Model.Total)</span></h2>
        <span class="muted small">Mới nhất trước · dòng @from–@to / @Model.Total</span>
    </div>
    <p class="muted small">Nguồn: <code>data/logs/audit-*.log</code> · hiển thị tối đa @GunnyPanel.Pages.AuditModel.MaxEntries dòng gần nhất.</p>
    <div class="table-wrap">
        <table class="list compact">
            <thead><tr><th>Thời gian</th><th>User</th><th>Hành động</th><th>Chi tiết</th></tr></thead>
            <tbody>
            @foreach (var entry in Model.Entries)
            {
                <tr>
                    <td class="mono">@entry.Time.ToString("dd/MM HH:mm:ss")</td>
                    <td>@entry.User</td>
                    <td>@entry.Action</td>
                    <td class="muted small">@entry.Detail</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <partial name="_Pager" model="Model.Pager" />
</section>
