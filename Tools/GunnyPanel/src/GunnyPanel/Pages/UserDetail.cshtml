@page "/Users/Details"
@model GunnyPanel.Pages.UserDetailModel
@{
    ViewData["Title"] = "Chi tiết người dùng";
    ViewData["Subtitle"] = "Thông tin tài khoản, level, vật phẩm và thao tác quản trị";
}

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert danger">@Model.Error</div>
    <a class="btn" href="/Users">‹ Về danh sách</a>
}
else if (Model.Account != null)
{
    var u = Model.Account;
    <div class="page-head">
        <h2>@u.NickName <span class="muted small">(@u.UserName · ID @u.UserID)</span></h2>
        <div class="row gap" style="margin-top:0;">
            <span class="badge-ok"><i class="fa fa-lock"></i> Đọc + thao tác có xác nhận</span>
            <a class="btn small" href="/Users">‹ Về danh sách</a>
        </div>
    </div>

    <div class="grid two">
        <section class="card">
            <h2>Thông tin tài khoản</h2>
            <table class="mini">
                <tr><td><b>Tài khoản</b></td><td>@u.UserName</td></tr>
                <tr><td><b>NickName</b></td><td>@u.NickName</td></tr>
                <tr><td><b>Giới tính</b></td><td>@(u.Sex ? "♂ Nam" : "♀ Nữ")</td></tr>
                <tr><td><b>Level</b></td><td class="mono">@u.Grade</td></tr>
                <tr>
                    <td><b>Lực chiến</b></td>
                    <td class="mono">
                        @Model.DisplayFightPower.ToString("N0")
                        @if (Model.LiveStats != null) { <span class="muted small">(live)</span> }
                    </td>
                </tr>
                @if (Model.LiveStats != null)
                {
                    <tr><td colspan="2" class="muted small" style="padding-top:8px;"><b>Chỉ số chiến đấu (live)</b></td></tr>
                    <tr><td><b>Tấn công</b></td><td class="mono">@Model.LiveStats.Attack.ToString("N0")</td></tr>
                    <tr><td><b>Phòng thủ</b></td><td class="mono">@Model.LiveStats.Defence.ToString("N0")</td></tr>
                    <tr><td><b>Nhanh nhẹn</b></td><td class="mono">@Model.LiveStats.Agility.ToString("N0")</td></tr>
                    <tr><td><b>May mắn</b></td><td class="mono">@Model.LiveStats.Luck.ToString("N0")</td></tr>
                    <tr><td><b>Máu</b></td><td class="mono">@Model.LiveStats.Hp.ToString("N0")</td></tr>
                    <tr><td><b>Ma công</b></td><td class="mono">@Model.LiveStats.MagicAttack.ToString("N0")</td></tr>
                    <tr><td><b>Ma kháng</b></td><td class="mono">@Model.LiveStats.MagicDefence.ToString("N0")</td></tr>
                    <tr><td><b>Sát thương</b></td><td class="mono">@Model.LiveStats.Damage.ToString("N0")</td></tr>
                    <tr><td><b>Thể lực</b></td><td class="mono">@Model.LiveStats.Energy.ToString("N0")</td></tr>
                }
                else if (u.State > 0)
                {
                    <tr><td colspan="2" class="muted small" style="padding-top:8px;">Chỉ số chiến đấu live: đang chờ Road GM API (bản Road mới).</td></tr>
                }
                <tr><td><b>GP</b></td><td class="mono">@u.GP.ToString("N0")</td></tr>
                <tr><td><b>Xu</b></td><td class="mono">@u.Money.ToString("N0")</td></tr>
                <tr><td><b>Vàng</b></td><td class="mono">@u.Gold.ToString("N0")</td></tr>
                <tr><td><b>Email</b></td><td>@(string.IsNullOrWhiteSpace(u.Email) ? "—" : u.Email)</td></tr>
                <tr>
                    <td><b>Trạng thái</b></td>
                    <td>
                        @(u.State > 0 ? Html.Raw("<span class=\"state-pill online\">Online</span>") : Html.Raw("<span class=\"state-pill offline\">Offline</span>"))
                        <button type="button" class="btn small" id="live-state-check" data-user-id="@u.UserID"><i class="fa fa-bolt"></i> Kiểm tra live</button>
                        <div class="muted small" id="live-state-result"></div>
                    </td>
                </tr>
                <tr><td><b>Lần cuối</b></td><td class="mono">@u.LastDate</td></tr>
                <tr><td><b>Ngày tạo</b></td><td class="mono">@Get("Date")</td></tr>
                <tr><td><b>Guild</b></td><td>@(string.IsNullOrWhiteSpace(Model.GuildName) ? (u.ConsortiaID > 0 ? "ID " + u.ConsortiaID : "—") : Model.GuildName)</td></tr>
                <tr><td><b>Hôn nhân</b></td><td>@(Get("IsMarried") == "True" || Get("IsMarried") == "1" ? "Đã kết hôn" : "Độc thân")</td></tr>
            </table>
        </section>

        <section class="card">
            <h2>Trạng thái khác (chỉ đọc)</h2>
            <table class="mini">
                <tr><td><b>Điểm thành tựu</b></td><td class="mono">@Get("AchievementPoint")</td></tr>
                <tr><td><b>VipIntegral</b></td><td class="mono">@Get("VipIntegral")</td></tr>
                <tr><td><b>Số lần đăng nhập</b></td><td class="mono">@Get("LoginCount")</td></tr>
                <tr><td><b>OnlineTime</b></td><td class="mono">@Get("OnlineTime")</td></tr>
                <tr><td><b>ChargeDate</b></td><td class="mono">@Get("ChargeDate")</td></tr>
                <tr><td><b>Ban chat</b></td><td>@(Get("IsBanChat") == "True" || Get("IsBanChat") == "1" ? "Bị cấm chat" : "Bình thường")</td></tr>
                <tr><td><b>Hết cấm chat</b></td><td class="mono">@Get("BanChatEndDate")</td></tr>
                <tr><td><b>ForbidDate</b></td><td class="mono">@Get("ForbidDate")</td></tr>
                <tr><td><b>Lý do khóa</b></td><td>@Get("ForbidReason")</td></tr>
                <tr><td><b>Mật khẩu cấp 2</b></td><td class="mono">@(string.IsNullOrWhiteSpace(Get("PasswordTwo")) ? "—" : "••••••")</td></tr>
            </table>
            <p class="muted small">Kick dùng <b>CenterService</b> (WCF/API có sẵn của Gunny — không sửa Full Source/Service); ban/unban và sửa tiền/level dùng khung “Thao tác quản trị” bên dưới.</p>
        </section>
    </div>

    @if (Model.CanWrite)
    {
        <section class="card" id="admin-actions">
            <h2>Thao tác quản trị (admin / gm)</h2>
            @Html.AntiForgeryToken()
            <div class="alert info">
                ⚠ <b>Trước khi sửa tiền / vàng / GP / level:</b> hãy cho nhân vật <b>offline (đăng xuất game)</b>.
                Nếu nhân vật đang online, panel sẽ <b>từ chối</b> sửa để tránh bị server ghi đè dữ liệu.
                Nếu đang online, dùng nút <b>Kick</b> (CenterService) rồi chờ vài giây trước khi sửa.
                Ban khi đang online có hiệu lực khi người chơi đăng nhập lại.
            </div>

            @if (u.State > 0)
            {
                <div class="alert danger">Nhân vật hiện đang <b>Online</b> — không thể sửa tiền/level. Hãy <b>Kick</b> (bên dưới) hoặc cho offline trước.</div>
            }

            <div class="admin-grid">
                <div>
                    <h3 style="font-size:14px;margin:6px 0 8px;">Ban / Unban</h3>
                    <form method="post" asp-page-handler="Ban">
                        <input type="hidden" name="id" value="@u.UserID" />
                        <label>Số ngày ban</label>
                        <input type="number" name="days" value="7" min="1" max="3650" />
                        <label>Lý do</label>
                        <input name="reason" placeholder="Vi phạm điều khoản..." maxlength="1000" />
                        <label>Nhập lại NickName để xác nhận</label>
                        <input name="confirmNick" placeholder="@u.NickName" autocomplete="off" />
                        <button type="submit" class="btn danger"><i class="fa fa-lock"></i> Ban tài khoản</button>
                    </form>

                    <form method="post" asp-page-handler="Unban" style="margin-top:14px;">
                        <input type="hidden" name="id" value="@u.UserID" />
                        <label>Mở ban — nhập lại NickName</label>
                        <input name="confirmNick" placeholder="@u.NickName" autocomplete="off" />
                        <button type="submit" class="btn primary"><i class="fa fa-lock"></i> Unban tài khoản</button>
                    </form>

                    <h3 style="font-size:14px;margin:18px 0 8px;">Kick (CenterService)</h3>
                    <div class="row gap" style="flex-wrap:wrap;">
                        <input id="kick-reason" placeholder="Lý do (không bắt buộc)" maxlength="200" style="flex:1;min-width:150px;" />
                        <button type="button" class="btn danger" id="kick-user" data-user-id="@u.UserID" data-nick="@u.NickName"><i class="fa fa-signout"></i> Kick</button>
                    </div>
                    <div class="muted small" id="kick-result" style="margin-top:6px;">
                        Ngắt kết nối người chơi đang online (<code>CenterService.KitoffUser</code> — API có sẵn, không sửa Service);
                        audit ghi <code>road.kick</code>. Kick xong chờ vài giây rồi mới sửa tiền/level.
                    </div>
                </div>

                <div>
                    <h3 style="font-size:14px;margin:6px 0 8px;">Sửa tiền tệ / level</h3>
                    <form method="post" asp-page-handler="Edit">
                        <input type="hidden" name="id" value="@u.UserID" />
                        <div class="field-grid">
                            <div>
                                <label>Xu (Money)</label>
                                <input type="number" name="money" value="@u.Money" min="0" max="2147483647" />
                            </div>
                            <div>
                                <label>Vàng (Gold)</label>
                                <input type="number" name="gold" value="@u.Gold" min="0" max="2147483647" />
                            </div>
                            <div>
                                <label>Xu khóa (GiftToken)</label>
                                <input type="number" name="giftToken" value="@Model.Info.GetValueOrDefault("GiftToken")" min="0" max="2147483647" />
                            </div>
                            <div>
                                <label>Level (tối đa 70)</label>
                                <input type="number" name="grade" value="@u.Grade" min="1" max="70" />
                            </div>
                        </div>
                        <label>Nhập lại NickName để xác nhận</label>
                        <input name="confirmNick" placeholder="@u.NickName" autocomplete="off" />
                        <button type="submit" class="btn primary"><i class="fa fa-refresh"></i> Cập nhật dữ liệu</button>
                    </form>
                    <p class="muted small">Xu/Vàng/Xu khóa tối đa 2,147,483,647; Level chỉ sửa trong khoảng 1–70. Audit ghi lại giá trị cũ → mới.</p>
                </div>
            </div>
        </section>

        <section class="card">
            <h2>Cấm chat &amp; thư tùy chỉnh</h2>
            <div class="alert info">
                <b>Ban chat</b> ghi <code>IsBanChat</code> / <code>BanChatEndDate</code> — có hiệu lực khi người chơi
                <b>đăng nhập lại</b> (hoặc dùng Kick ở trên). <b>Gửi thư tùy chỉnh</b> ghi thẳng hộp thư
                (<code>User_Messages</code>) và có thể kèm Vàng / Xu / Xu khóa — <b>không kèm vật phẩm</b>
                (dùng Award nếu cần gửi item). Cả hai đều bắt nhập lại NickName và ghi audit.
            </div>
            <div class="admin-grid">
                <div>
                    <h3 style="font-size:14px;margin:6px 0 8px;">Ban chat</h3>
                    <form method="post" asp-page-handler="BanChat">
                        <input type="hidden" name="id" value="@u.UserID" />
                        <label>Số ngày cấm chat</label>
                        <input type="number" name="days" value="7" min="1" max="3650" />
                        <label>Lý do (ghi audit)</label>
                        <input name="reason" placeholder="Spam chat, xúc phạm..." maxlength="500" />
                        <label>Nhập lại NickName để xác nhận</label>
                        <input name="confirmNick" placeholder="@u.NickName" autocomplete="off" />
                        <button type="submit" class="btn danger"><i class="fa fa-comment-slash"></i> Cấm chat</button>
                    </form>

                    <form method="post" asp-page-handler="UnbanChat" style="margin-top:14px;">
                        <input type="hidden" name="id" value="@u.UserID" />
                        <label>Mở ban chat — nhập lại NickName</label>
                        <input name="confirmNick" placeholder="@u.NickName" autocomplete="off" />
                        <button type="submit" class="btn primary"><i class="fa fa-comment"></i> Mở ban chat</button>
                    </form>
                </div>

                <div>
                    <h3 style="font-size:14px;margin:6px 0 8px;">Gửi thư tùy chỉnh (không kèm item)</h3>
                    <form method="post" asp-page-handler="SendMail">
                        <input type="hidden" name="id" value="@u.UserID" />
                        <label>Tiêu đề</label>
                        <input name="title" value="Thư từ GM Panel" maxlength="500" />
                        <label>Nội dung</label>
                        <textarea name="content" rows="3" maxlength="4000" placeholder="Nội dung thư..."></textarea>
                        <div class="field-grid">
                            <div>
                                <label>Vàng (Gold)</label>
                                <input type="number" name="mailGold" value="0" min="0" max="2147483647" />
                            </div>
                            <div>
                                <label>Xu (Money)</label>
                                <input type="number" name="mailMoney" value="0" min="0" max="2147483647" />
                            </div>
                            <div>
                                <label>Xu khóa (GiftToken)</label>
                                <input type="number" name="mailGiftToken" value="0" min="0" max="2147483647" />
                            </div>
                        </div>
                        <label>Nhập lại NickName để xác nhận</label>
                        <input name="confirmNick" placeholder="@u.NickName" autocomplete="off" />
                        <button type="submit" class="btn primary"><i class="fa fa-envelope"></i> Gửi thư</button>
                    </form>
                    <p class="muted small">Thư vào hộp thư ngay; nếu người chơi đang online, panel gọi MailNotice để client cập nhật.</p>
                </div>
            </div>
        </section>

        <section class="card award-card">
            <h2>Gửi vật phẩm (Award qua hộp thư)</h2>
            <div class="alert info">
                Chọn <b>thể loại</b> → bấm <b>Hiện danh sách vật phẩm</b>.
                Cửa sổ chọn item có <b>ảnh + phân trang</b>; bấm item để xem chi tiết, nhập số lượng / chỉ số / đúc vàng rồi Gửi.
                <b>Gửi được cả khi nhân vật đang online</b> — item vào hộp thư ngay, người chơi mở hộp thư để nhận (không cần đăng nhập lại).
                <b>Trang bên ngoài không reload</b>; chỉ cửa sổ chọn item tải lại khi đổi trang/chọn item.
            </div>

            <div class="field-grid">
                <div>
                    <label>Thể loại</label>
                    <select id="award-cat">
                        <option value="0">— Tất cả category —</option>
                        @foreach (var cat in Model.Categories)
                        {
                            <option value="@cat.Id">@cat.Id — @cat.Name</option>
                        }
                    </select>
                </div>
            </div>
            <div class="row gap" style="margin-top:12px;">
                <button type="button" class="btn primary" id="open-award-picker"><i class="fa fa-search"></i> Hiện danh sách vật phẩm</button>
                <span class="muted small">Mở cửa sổ riêng; trang bên ngoài giữ nguyên trạng thái.</span>
            </div>

            @if (Model.Embed != 1)
            {
                <div class="modal-backdrop" id="award-picker-overlay" style="display:none;">
                    <div class="modal-card award-modal" style="padding:0;overflow:hidden;">
                        <div class="modal-head" style="margin:0;padding:12px 16px;border-bottom:1px solid var(--line-soft);">
                            <h3>Chọn vật phẩm gửi về user</h3>
                            <button type="button" class="btn small" id="close-award-picker">Đóng</button>
                        </div>
                        <iframe id="award-picker-frame" title="Chọn vật phẩm" style="width:100%;height:72vh;border:0;display:block;background:#fff;"></iframe>
                    </div>
                </div>
            }

            @if (Model.Picker == 1 && Model.Embed == 1)
            {
                <div class="modal-backdrop">
                    <div class="modal-card award-modal">
                        <div class="modal-head">
                            <h3>Chọn vật phẩm — @(Model.Categories.FirstOrDefault(c => c.Id == Model.AwardCat)?.Name ?? "Tất cả category")</h3>
                        </div>
                        <form method="get" class="award-modal-search" id="award-picker-filter">
                            <input type="hidden" name="id" value="@u.UserID" />
                            <input type="hidden" name="cat" value="@Model.AwardCat" />
                            <input type="hidden" name="picker" value="1" />
                            @if (Model.Embed == 1)
                            {
                                <input type="hidden" name="embed" value="1" />
                            }
                            <label for="award-name-search">Tìm theo tên:</label>
                            <input id="award-name-search" name="q" value="@Model.AwardQ" placeholder="vd: nhẫn, áo..." autocomplete="off" />
                            <label for="award-id-search">TemplateID:</label>
                            <input id="award-id-search" name="sel" type="number" min="1" inputmode="numeric" autocomplete="off"
                                   placeholder="vd: 5101" value="@(Model.SelectedAward?.TemplateId)" />
                            <button type="submit" class="btn small" id="award-id-go">Xem</button>
                            <span class="muted small">Nhập tên hoặc TemplateID rồi bấm Xem.</span>
                        </form>
                        <div class="award-picker">
                            <div class="award-picker-list">
                                @if (Model.AwardItems.Count > 0)
                                {
                                    <div class="award-item-grid">
                                        @foreach (var it in Model.AwardItems)
                                        {
                                            <a class="award-item @(Model.SelectedAward?.TemplateId == it.TemplateId ? "active" : null)" href="@Model.AwardSelectUrl(it.TemplateId)">
                                                <span class="item-thumb">
                                                    <i class="fa fa-cube"></i>
                                                    @if (!string.IsNullOrWhiteSpace(it.ImageUrl))
                                                    {
                                                        <img src="@it.ImageUrl" alt="@it.Name" loading="lazy" onerror="this.remove();" />
                                                    }
                                                </span>
                                                <span class="award-item-info">
                                                    <b>@it.Name</b>
                                                    <em>#@it.TemplateId · @it.CategoryName</em>
                                                </span>
                                            </a>
                                        }
                                    </div>
                                    <div class="award-pager">
                                        @if (Model.AwardPage > 1)
                                        {
                                            <a class="btn small" href="@Model.AwardPageUrl(Model.AwardPage - 1)">‹ Trước</a>
                                        }
                                        else
                                        {
                                            <span class="btn small disabled">‹ Trước</span>
                                        }
                                        <span class="muted small">Trang @Model.AwardPage / @Model.AwardTotalPages · @Model.AwardTotal item</span>
                                        <form method="get" class="award-page-jump">
                                            <input type="hidden" name="id" value="@u.UserID" />
                                            <input type="hidden" name="cat" value="@Model.AwardCat" />
                                            <input type="hidden" name="q" value="@Model.AwardQ" />
                                            <input type="hidden" name="picker" value="1" />
                                            @if (Model.Embed == 1)
                                            {
                                                <input type="hidden" name="embed" value="1" />
                                            }
                                            <label>Trang</label>
                                            <input type="number" name="apage" id="award-page-input" min="1" max="@Model.AwardTotalPages" value="@Model.AwardPage" />
                                            <button type="submit" class="btn small">Đi</button>
                                        </form>
                                        @if (Model.AwardPage < Model.AwardTotalPages)
                                        {
                                            <a class="btn small" href="@Model.AwardPageUrl(Model.AwardPage + 1)">Sau ›</a>
                                        }
                                        else
                                        {
                                            <span class="btn small disabled">Sau ›</span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <p class="muted">@(Model.AwardListMessage ?? "Không có item phù hợp. Thử thể loại khác.")</p>
                                }
                            </div>

                            <div class="award-picker-detail">
                                @if (!string.IsNullOrWhiteSpace(Model.AwardSelectMessage))
                                {
                                    <div class="alert danger">@Model.AwardSelectMessage</div>
                                }
                                @if (Model.SelectedAward != null)
                                {
                                    var sel = Model.SelectedAward;
                                    <div class="award-detail-head">
                                        <span class="item-thumb big">
                                            <i class="fa fa-cube"></i>
                                            @if (!string.IsNullOrWhiteSpace(sel.ImageUrl))
                                            {
                                                <img src="@sel.ImageUrl" alt="@sel.Name" onerror="this.remove();" />
                                            }
                                        </span>
                                        <div>
                                            <div class="award-detail-name">@sel.Name</div>
                                            <div class="muted small">TemplateID @sel.TemplateId · @sel.CategoryName · Max stack @sel.MaxCount</div>
                                        </div>
                                    </div>

                                    <form method="post" asp-page-handler="SendItem" id="award-send-form">
                                        <input type="hidden" name="id" value="@u.UserID" />
                                        <input type="hidden" name="templateId" value="@sel.TemplateId" />

                                        <div class="field-grid">
                                            <div>
                                                <label>Số lượng (1–9999)</label>
                                                <input type="number" name="count" value="1" min="1" max="9999" />
                                            </div>
                                            <div>
                                                <label>Khóa (bind)</label>
                                                <select name="bind">
                                                    <option value="true">Có (bind)</option>
                                                    <option value="false" selected>Không</option>
                                                </select>
                                            </div>
                                            <div>
                                                <label>Hạn dùng (ngày, 0 = vĩnh viễn)</label>
                                                <input type="number" name="validDays" value="0" min="0" max="3650" />
                                            </div>
                                        </div>

                                        @if (sel.AllowStats)
                                        {
                                            <div class="row gap" style="margin:4px 0 6px; align-items:center;">
                                                <label style="margin:0;">Cộng chỉ số (tối đa 50 mỗi chỉ số; để 0 nếu không cộng)</label>
                                                <button type="button" class="btn small" id="award-max-stats"><i class="fa fa-bolt"></i> Cộng nhanh 4 chỉ số = 50</button>
                                            </div>
                                            <div class="field-grid">
                                                <div>
                                                    <label>Công</label>
                                                    <input type="number" name="attack" value="0" min="0" max="50" />
                                                </div>
                                                <div>
                                                    <label>Thủ</label>
