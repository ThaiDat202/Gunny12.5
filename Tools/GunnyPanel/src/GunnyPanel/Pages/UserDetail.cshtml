    <section class="card">
        <div class="page-head">
            <h2>Vật phẩm <span class="muted small">(@Model.ItemTotal)</span></h2>
            <div class="row gap" style="margin-top:0;">
                <a class="btn small @(Model.Bag == null ? "primary" : null)" href="/Users/Details?id=@u.UserID">Tất cả</a>
                @foreach (var bag in Model.Bags)
                {
                    <a class="btn small @(Model.Bag == bag.BagType ? "primary" : null)" href="/Users/Details?id=@u.UserID&bag=@bag.BagType">@GunnyPanel.Pages.UserDetailModel.BagLabel(bag.BagType) (@bag.Count)</a>
                }
            </div>
        </div>

        @if (Model.Items.Count == 0)
        {
            <p class="muted">Không có vật phẩm.</p>
        }
        else
        {
            <div class="table-wrap">
                <table class="list compact">
                    <thead>
                    <tr><th>ItemID</th><th>Tên vật phẩm</th><th>TemplateID</th><th>Loại</th><th>Place</th><th>SL</th><th>+Cường</th><th>Khóa</th><th>Hạn</th><th>Bắt đầu</th>@if (Model.CanWrite) { <th>Thao tác</th> }</tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td class="mono">@item.ItemID</td>
                            <td><a href="/Users/Item?id=@item.ItemID&uid=@u.UserID">@(string.IsNullOrWhiteSpace(item.Name) ? "(không có trong Shop_Goods)" : item.Name)</a></td>
                            <td class="mono">@item.TemplateID</td>
                            <td>@GunnyPanel.Pages.UserDetailModel.BagLabel(item.BagType)</td>
                            <td class="mono">@item.Place</td>
                            <td class="mono">@item.Count</td>
                            <td class="mono">@item.StrengthenLevel</td>
                            <td>@(item.IsBinds ? "Có" : "Không")</td>
                            <td>@(item.ValidDate == "0" ? "Vĩnh viễn" : item.ValidDate + " ngày")</td>
                            <td class="mono small">@item.BeginDate</td>
                            @if (Model.CanWrite)
                            {
                                <td>
                                    <form method="post" asp-page-handler="DeleteItem" onsubmit="return confirm('Xoá (soft-delete) vật phẩm @item.ItemID — @item.Name?');" style="margin:0;">
                                        <input type="hidden" name="id" value="@u.UserID" />
                                        <input type="hidden" name="itemId" value="@item.ItemID" />
                                        <input type="hidden" name="confirmNick" value="@u.NickName" />
                                        <button type="submit" class="btn small danger"><i class="fa fa-times"></i> Xoá</button>
                                    </form>
                                </td>
                            }
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <partial name="_Pager" model="Model.Pager" />
        }
    </section>
}

@functions {
    private string Get(string key) => Model.Info.TryGetValue(key, out var value) && !string.IsNullOrWhiteSpace(value) ? value : "—";
}

@section Scripts {
    <script>
        (function () {
            var openPicker = document.getElementById('open-award-picker');
            var pickerOverlay = document.getElementById('award-picker-overlay');
            var pickerFrame = document.getElementById('award-picker-frame');
            var closePicker = document.getElementById('close-award-picker');
            if (openPicker && pickerOverlay && pickerFrame) {
                openPicker.addEventListener('click', function () {
                    var cat = document.getElementById('award-cat');
                    var catId = cat ? cat.value : '0';
                    pickerFrame.src = '/Users/Details?id=@Model.Id&cat=' + encodeURIComponent(catId) + '&picker=1&embed=1';
                    pickerOverlay.style.display = 'flex';
                });
                var hidePicker = function () {
                    pickerOverlay.style.display = 'none';
                    pickerFrame.src = 'about:blank';
                };
                if (closePicker) closePicker.addEventListener('click', hidePicker);
                document.addEventListener('keydown', function (e) {
                    if (e.key === 'Escape' && pickerOverlay.style.display !== 'none') hidePicker();
                });
                window.addEventListener('message', function (e) {
                    var d = e.data;
                    if (!d || d.type !== 'gp-award-result') return;
                    if (window.gpToast) window.gpToast(d.message || 'Đã gửi vật phẩm.', !d.ok);
                });
            }

            var maxStats = document.getElementById('award-max-stats');
            if (maxStats) {
                maxStats.addEventListener('click', function () {
                    var f = document.getElementById('award-send-form');
                    if (!f) return;
                    ['attack', 'defend', 'agility', 'luck'].forEach(function (name) {
                        var el = f.querySelector('input[name="' + name + '"]');
                        if (el) el.value = '50';
                    });
                });
            }

            var awardForm = document.getElementById('award-send-form');
            if (awardForm) {
                awardForm.addEventListener('submit', function (e) {
                    e.preventDefault();
                    var btn = awardForm.querySelector('button[type="submit"]');
                    var oldHtml = btn ? btn.innerHTML : '';
                    if (btn) { btn.disabled = true; btn.innerHTML = 'Đang gửi...'; }
                    fetch('/Users/Details?handler=SendItemAjax', {
                        method: 'POST',
                        body: new FormData(awardForm),
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    })
                        .then(function (r) { return r.json().then(function (d) { return { status: r.status, data: d }; }); })
                        .then(function (res) {
                            var d = res.data || {};
                            var message = d.message || (res.status === 200 ? 'Đã gửi vật phẩm.' : 'Gửi thất bại.');
                            if (window.parent && window.parent !== window) {
                                window.parent.postMessage({ type: 'gp-award-result', ok: !!d.ok, message: message }, '*');
                            } else if (window.gpToast) {
                                window.gpToast(message, !d.ok);
                            }
                        })
                        .catch(function () {
                            if (window.gpToast) window.gpToast('Không gửi được (lỗi mạng/server).', true);
                        })
                        .then(function () {
                            if (btn) { btn.disabled = false; btn.innerHTML = oldHtml; }
                        });
                });
            }
        })();
    </script>

    <script>
        (function () {
            var adminCard = document.getElementById('admin-actions');
            var tokenInput = adminCard ? adminCard.querySelector('input[name="__RequestVerificationToken"]') : null;

            function say(text, isError) {
                if (window.gpToast) window.gpToast(text, !!isError);
                else alert(text);
            }

            var liveButton = document.getElementById('live-state-check');
            var liveResult = document.getElementById('live-state-result');
            if (liveButton && liveResult) {
                liveButton.addEventListener('click', function () {
                    var userId = liveButton.getAttribute('data-user-id');
                    liveResult.textContent = 'Đang hỏi CenterService...';
                    liveButton.disabled = true;
                    fetch('/Users/Details?handler=PlayerState&id=' + encodeURIComponent(userId), {
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    })
                        .then(function (response) {
                            return response.json().then(function (json) { return json; }, function () {
                                return { ok: false, message: 'Server trả lỗi (HTTP ' + response.status + ').' };
                            });
                        })
                        .then(function (data) {
                            liveResult.textContent = data.ok
                                ? 'CenterService: ' + data.message + ' (mã ' + data.centerState + ') · DB State = ' + data.dbState
                                : (data.message || 'Không kiểm tra được.');
                        })
                        .catch(function () {
                            liveResult.textContent = 'Không gửi được yêu cầu (lỗi mạng/server).';
                        })
                        .then(function () { liveButton.disabled = false; });
                });
            }

            var kickButton = document.getElementById('kick-user');
            var kickResult = document.getElementById('kick-result');
            var kickReason = document.getElementById('kick-reason');
            if (kickButton && tokenInput) {
                kickButton.addEventListener('click', function () {
                    var userId = kickButton.getAttribute('data-user-id');
                    var nick = kickButton.getAttribute('data-nick') || ('UserID ' + userId);
                    if (!confirm('Kick ' + nick + ' (UserID ' + userId + ') khỏi game?\nNgười chơi sẽ bị ngắt kết nối ngay.')) return;

                    var body = new FormData();
                    body.append('id', userId);
                    body.append('reason', kickReason ? kickReason.value : '');
                    body.append('__RequestVerificationToken', tokenInput.value);

                    kickButton.disabled = true;
                    var oldText = kickButton.innerHTML;
                    kickButton.innerHTML = 'Đang kick...';
                    if (kickResult) kickResult.textContent = 'Đang gửi lệnh kick...';
                    fetch('/Users/Details?handler=Kick', {
                        method: 'POST',
                        body: body,
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    })
                        .then(function (response) {
                            return response.json().then(function (json) { return json; }, function () {
                                return { ok: false, message: 'Server trả lỗi (HTTP ' + response.status + ').' };
                            });
                        })
                        .then(function (data) {
                            if (kickResult) kickResult.textContent = data.message || '';
                            say(data.message || 'Không có phản hồi.', !data.ok);
                            if (data.ok) window.setTimeout(function () { window.location.reload(); }, 1500);
                        })
                        .catch(function () {
                            if (kickResult) kickResult.textContent = 'Không gửi được yêu cầu (lỗi mạng/server).';
                            say('Không gửi được yêu cầu (lỗi mạng/server).', true);
                        })
                        .then(function () {
                            kickButton.disabled = false;
                            kickButton.innerHTML = oldText;
                        });
                });
            }
        })();
    </script>

    <script>
        (function () {
            var card = document.getElementById('gm-tool-card');
            if (!card) return;

            var userId = document.getElementById('gm-tool-user-id').value;
            var tokenInput = card.querySelector('input[name="__RequestVerificationToken"]');
            var progress = document.getElementById('gm-progress');
            var fullButton = document.getElementById('gm-set-full');
            var liveBadge = document.getElementById('gm-live-badge');
            var liveEnabledInput = document.getElementById('gm-live-enabled');
            var featureButtons = Array.prototype.slice.call(card.querySelectorAll('[data-gm-feature]'));
            var order = [
                ['king', 'Cấp Vua Gà'], ['guard', 'Bảo Vệ'], ['honor', 'Vinh Dự'],
                ['explorer', 'Sổ Tay'], ['titles', 'Danh Hiệu'], ['sworn', 'Nhẫn Cầu Hôn'],
                ['sworn_love', 'Nhẫn Cầu Hôn — Tình Ý'],
                ['amulet_level', 'Hỗ Trợ Lên Cấp'], ['amulet_wash', 'Hỗ Trợ Tẩy Luyện'],
                ['potential', 'Tiềm Năng'], ['phuma', 'Phụ Ma'], ['duchon', 'Đúc Hồn'],
                ['beads', 'Châu Báu'], ['magicstone', 'Ma Thạch'], ['magicjade', 'Ma Ngọc'],
                ['avatar', 'Bộ Sưu Tập'], ['album', 'Full Album'],
                ['mark_train', 'Ấn — Luyện'], ['mark_refine', 'Ấn — Luyện hóa']
            ];

            if (!tokenInput) return;
            var token = tokenInput.value;

            function say(text, error) {
                if (window.gpToast) window.gpToast(text, !!error);
                else if (error) alert(text);
            }

            function setBusy(busy) {
                fullButton.disabled = busy;
                featureButtons.forEach(function (b) { b.disabled = busy; });
            }

            function liveSuffix(live) { return live ? ' ◆ live' : ''; }

            // Badge trạng thái Road GM API (chỉ hiển thị, không ảnh hưởng thao tác)
            function setLiveBadge(ok, text) {
                if (!liveBadge) return;
                liveBadge.innerHTML = '';
                var icon = document.createElement('i');
                icon.className = ok ? 'fa fa-bolt' : 'fa fa-plug';
                liveBadge.appendChild(icon);
                liveBadge.appendChild(document.createTextNode(' ' + (text || (ok ? 'Road GM API: OK' : 'Road GM API: không kết nối'))));
                liveBadge.style.color = ok ? '' : '#8f3a47';
            }

            (function loadLiveStatus() {
                var enabledAttr = liveEnabledInput ? liveEnabledInput.value : '0';
                if (enabledAttr !== '1') {
                    if (liveBadge) {
                        liveBadge.innerHTML = '';
                        var i = document.createElement('i');
                        i.className = 'fa fa-plug';
                        liveBadge.appendChild(i);
                        liveBadge.appendChild(document.createTextNode(' Road GM API: tắt'));
                        liveBadge.style.color = '#8f3a47';
                    }
                    return;
                }
                fetch('/Users/Details?handler=LiveStatus', { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                    .then(function (res) { return res.json(); })
                    .then(function (d) {
                        if (d && d.ok) setLiveBadge(true, d.message || 'Road GM API: OK');
                        else setLiveBadge(false, (d && d.message) || 'Road GM API: không kết nối');
                    })
                    .catch(function () { setLiveBadge(false, 'Road GM API: không kết nối'); });
            })();

            async function callFeature(feature) {
                var fd = new FormData();
                fd.append('id', userId);
                fd.append('feature', feature);
                fd.append('__RequestVerificationToken', token);
                var res = await fetch('/Users/Details?handler=GmTool', {
                    method: 'POST',
                    body: fd,
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                var data = {};
                try { data = await res.json(); } catch (_) { data = { ok: false, message: 'Server trả về lỗi.' }; }
                return {
                    ok: res.ok && data.ok === true,
                    live: data.live === true,
                    message: data.message || 'Không có phản hồi.'
                };
            }

            featureButtons.forEach(function (btn) {
                btn.addEventListener('click', async function () {
                    var feature = btn.getAttribute('data-gm-feature');
                    var label = (btn.getAttribute('data-gm-label') || btn.textContent || '').replace(/\s+/g, ' ').trim();
                    setBusy(true);
                    if (progress) { progress.textContent = 'Đang chạy ' + label + '...'; progress.title = ''; }
                    try {
                        var r = await callFeature(feature);
                        var msg = 'Đã nâng cấp tối đa ' + label + (r.ok ? ' thành công' : ' thất bại');
                        var detail = (r.message || '').trim();
                        if (progress) { progress.textContent = msg + liveSuffix(r.live); progress.title = detail; }
                        say(r.ok && detail ? detail : msg, !r.ok);
                    } catch (e) {
                        var failMsg = 'Đã nâng cấp tối đa ' + label + ' thất bại';
                        if (progress) { progress.textContent = failMsg; progress.title = e.message || ''; }
                        say(failMsg, true);
                    } finally {
                        setBusy(false);
                    }
                });
            });

            if (fullButton) {
                fullButton.addEventListener('click', async function () {
                    if (!confirm('Set FULL toàn bộ cho user ' + userId + '?\nThao tác ghi DB; nếu user đang online sẽ áp dụng live qua Road GM API.')) return;
                    setBusy(true);
                    var failed = [];
                    var liveCount = 0;
                    for (var i = 0; i < order.length; i++) {
                        var feature = order[i][0];
                        var label = order[i][1];
                        if (progress) progress.textContent = 'SET FULL ' + (i + 1) + '/' + order.length + ': ' + label;
                        try {
                            var r = await callFeature(feature);
                            if (!r.ok) failed.push(label + ': ' + r.message);
                            else if (r.live) liveCount++;
                            if (progress) progress.textContent = 'SET FULL ' + (i + 1) + '/' + order.length + ': ' + label + liveSuffix(r.live);
                        } catch (e) {
                            failed.push(label + ': ' + e.message);
                        }
                    }
                    setBusy(false);
                    var fullMsg = 'Đã nâng cấp tối đa toàn bộ ' + (failed.length === 0 ? 'thành công' : 'thất bại');
                    if (progress) {
                        progress.textContent = fullMsg + (liveCount > 0 ? ' (live ' + liveCount + ' bước)' : '');
                        progress.title = failed.length ? failed.join('\n') : '';
                    }
                    say(fullMsg, failed.length > 0);
                });
            }

            var clear = document.getElementById('gm-clear-progress');
            if (clear) clear.addEventListener('click', function () {
                if (progress) progress.textContent = 'Sẵn sàng';
            });
        })();
    </script>
}
