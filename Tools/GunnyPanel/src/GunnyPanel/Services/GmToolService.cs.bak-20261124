using System;
using System.Collections.Generic;
using System.Threading.Tasks;
using GunnySuite.Core;

namespace GunnyPanel.Services;

/// <summary>
/// GM tool dùng trực tiếp DB, không phụ thuộc Road.Service.
/// Mỗi feature là 1 request AJAX riêng để tránh timeout.
/// </summary>
public sealed partial class GmToolService
{
    private readonly SqlDatabase _db;

    public GmToolService(SqlDatabase db)
    {
        _db = db;
    }

    public static readonly string[] FeatureOrder =
    {
        "king", "guard", "honor", "explorer", "titles", "sworn", "sworn_love",
        "amulet_level", "amulet_wash", "potential", "phuma", "duchon",
        "beads", "avatar", "album", "magicstone", "magicjade", "battle_soul"
    };

    public async Task<(bool Ok, string Message)> RunAsync(int userId, string feature)
    {
        try
        {
            return feature switch
            {
                "king" => await KingAsync(userId),
                "guard" => await GuardAsync(userId),
                "honor" => await HonorAsync(userId),
                "explorer" => await ExplorerAsync(userId),
                "titles" => await TitlesAsync(userId),
                "sworn" => await SwornAsync(userId),
                "sworn_love" => await SwornLoveAsync(userId),
                "amulet_level" => await AmuletLevelAsync(userId),
                "amulet_wash" => await AmuletWashAsync(userId),
                "potential" => await PotentialAsync(userId),
                "phuma" => await PhuMaAsync(userId),
                "duchon" => await DucHonAsync(userId),
                "beads" => await BeadsAsync(userId),
                "avatar" => await AvatarAsync(userId),
                "album" => await AlbumAsync(userId),
                "magicstone" => await MagicStoneAsync(userId),
                "magicjade" => await MagicJadeAsync(userId),
                "battle_soul" => await BattleSoulAsync(userId),
                _ => (false, "Chức năng không hợp lệ.")
            };
        }
        catch (Exception ex)
        {
            return (false, "Lỗi: " + ex.Message);
        }
    }

    private async Task<(bool, string)> KingAsync(int userId)
    {
        var (rows, err) = await _db.ExecuteAsync("Db_Tank", $@"
UPDATE Sys_Users_Detail SET Grade = 70, GP = 857997577 WHERE UserID = @uid;
IF NOT EXISTS (SELECT 1 FROM King_Grade_Data WHERE UserID = @uid)
    INSERT INTO King_Grade_Data
        (UserID, ddtKingGrade, currentExp, usableNum, AttackLevel, DefenceLevel, AgilityLevel, LuckyLevel, MagicAttackLevel, MagicDefenceLevel)
    VALUES (@uid, 10, 0, 10, 10, 10, 10, 10, 10, 10);
UPDATE King_Grade_Data
SET ddtKingGrade = 10, currentExp = 0, usableNum = 10,
    AttackLevel = 10, DefenceLevel = 10, AgilityLevel = 10,
    LuckyLevel = 10, MagicAttackLevel = 10, MagicDefenceLevel = 10
WHERE UserID = @uid;",
            new Dictionary<string, object?> { ["uid"] = userId }, 60);

        return err == null
            ? (true, "Đã nâng user lên level 70 và Cấp Vua Gà level 10.")
            : (false, err);
    }

    private async Task<(bool, string)> GuardAsync(int userId)
    {
        var (_, err) = await _db.ExecuteAsync("Db_Tank", @"
UPDATE Sys_Users_Detail SET Grade = 50, GP = 63832646
WHERE UserID = @uid AND Grade < 50;
UPDATE Sys_Users_Detail SET guardCoreGrade = 20 WHERE UserID = @uid;",
            new Dictionary<string, object?> { ["uid"] = userId }, 60);

        return err == null
            ? (true, "Đã nâng user tối thiểu level 50 và Bảo Vệ level 20.")
            : (false, err);
    }

