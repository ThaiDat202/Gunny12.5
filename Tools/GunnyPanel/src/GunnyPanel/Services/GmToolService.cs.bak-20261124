        if (count == 0) return (false, "Bạn chưa có nhẫn/vòng tay.");

        var (_, err) = await _db.ExecuteAsync("Db_Tank", @"
UPDATE Sys_Users_Goods
SET enchantSpiritLevel = 20, IsBinds = 1
WHERE UserID = @uid AND BagType = 0
  AND TemplateID IN (SELECT TemplateID FROM Db_Tank_All.dbo.Shop_Goods WHERE CategoryID IN (8,9,28,29))",
