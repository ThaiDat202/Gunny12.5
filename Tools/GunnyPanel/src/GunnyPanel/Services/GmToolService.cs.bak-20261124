    private async Task<(bool, string)> PhuMaAsync(int userId)
    {
        var count = await CountOwnedRingsAsync(userId);
        if (count == 0) return (false, "Bạn chưa có nhẫn/vòng tay.");

        var (_, err) = await _db.ExecuteAsync("Db_Tank", @"
UPDATE Sys_Users_Goods
SET MagicLevel = 40, MagicExp = 298100, IsBinds = 1
WHERE UserID = @uid AND BagType = 0
  AND TemplateID IN (SELECT TemplateID FROM Db_Tank_All.dbo.Shop_Goods WHERE CategoryID IN (8,9,28,29))",
            new Dictionary<string, object?> { ["uid"] = userId }, 60);

        return err == null
            ? (true, "Đã nâng full Phụ Ma level 40 cho nhẫn/vòng tay đang trang bị.")
            : (false, err);
    }

