SET StrengthenLevel = 50, StrengthenTimes = 0, IsBinds = 1
WHERE UserID = @uid AND TemplateID = 390101 AND BagType = 0",
            new Dictionary<string, object?> { ["uid"] = userId }, 60);

        if (err != null) return (false, err);
        return rows == 0
            ? (false, "Bạn chưa trang bị bùa hộ thân.")
            : (true, "Đã nâng Bùa Hộ Thân lên level 50.");
