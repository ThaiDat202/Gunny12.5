IF NOT EXISTS (SELECT 1 FROM Sys_Users_Honor WHERE UserID = @uid)
    INSERT INTO Sys_Users_Honor (UserID, HonorLevel, HonorExp, Count, IsGet, GoodPeopleCardTime)
    VALUES (@uid, 100, 0, 3, 0, GETDATE());
UPDATE Sys_Users_Honor SET HonorLevel = 100, HonorExp = 0 WHERE UserID = @uid;",
            new Dictionary<string, object?> { ["uid"] = userId }, 60);

        return err == null ? (true, "Đã nâng Vinh Dự lên level 100.") : (false, err);
