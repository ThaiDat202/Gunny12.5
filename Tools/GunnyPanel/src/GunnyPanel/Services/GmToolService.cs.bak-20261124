IF NOT EXISTS (SELECT 1 FROM Sys_Users_Sworn WHERE UserID = @uid)
    INSERT INTO Sys_Users_Sworn
        (UserID, swornId, swornCount, todayGetSwornCount, isHasSwornItem, pveCount, pvpCount, giveCount, skillId, swornUserIDs)
    VALUES (@uid, 9522, 124860, 0, 1, 0, 0, 0, 1072, NULL);
UPDATE Sys_Users_Sworn
SET swornId = 9522, swornCount = 124860, isHasSwornItem = 1, skillId = 1072
